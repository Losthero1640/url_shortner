# Server Configuration
PORT=3000

# Base URL used to construct the shortened links returned to clients
# Local development:
BASE_URL=http://localhost:3000
# Production example:
# BASE_URL=https://your-domain.com

# MongoDB Database Connection String
# Local MongoDB instance:
MONGODB_URI=mongodb://127.0.0.1:27017/url-shortener

# MongoDB Atlas Cloud example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/url-shortener?retryWrites=true&w=majority
